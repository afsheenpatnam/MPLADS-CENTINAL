# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/mplad_insight
# For MongoDB Atlas, use something like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mplad_insight

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Astra LLM (optional — app runs and detection still works if unset)
# Any OpenAI-compatible chat-completions endpoint works here. Verified working with Groq's
# free tier: ASTRA_API_URL=https://api.groq.com/openai/v1/chat/completions,
# ASTRA_MODEL=qwen/qwen3.8-27b (get a free key at console.groq.com). Avoid Groq's
# openai/gpt-oss-* models for this app — they route their answer through a separate
# "reasoning" field and leave `message.content` empty, which this app's parser doesn't read.
ASTRA_API_KEY=
ASTRA_API_URL=
ASTRA_MODEL=

# Server
PORT=5000
NODE_ENV=production
CLIENT_URL=https://mplads-sentinel-ln0q.onrender.com

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
